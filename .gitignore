# Tenkai runtime state — never commit (sockets, pids, XDG overrides, Go build dirs)
.run/
*.log

# Read-only upstream clone (pinned commit recorded in UPSTREAM.md); never edited, not tracked
upstream/
.r

# The owner's local setup: the previous shell's commands, the private audit and
# the scrub terms. Never tracked: the public repo must not name them.
.local/

# The captured baseline of the live session: a process list and the D-Bus names
# it owns. That is the owner's own setup, so it is not in the public repo.
docs/baseline/
docs/baseline.txt

# AI tooling state (Freebuff project marker); never commit
.freebuff

# Compiled binaries from local `go build` verification runs; never commit
src/ryoku/hub/backend/ryoku-hub
src/ryoku/shell/ipc/ryoku-shell
src/ryoku/shell/ryogami/daemon/ryogami
