#!/usr/bin/env python3
"""mei-lock-verify: check a password against PAM, for Mei's lock screen.

	mei-lock-verify            read the password from stdin (one line)
	mei-lock-verify --user U   check U instead of the current user

Exit code 0 means the password was accepted, 1 means it was refused, 2 means
the check could not run at all.

What it touches, exactly:

* PAM service "login" (override with MEI_LOCK_PAM_SERVICE). On Arch that is
  /etc/pam.d/login, which includes pam_unix.so, so the account's hash in
  /etc/shadow is what is checked. Nothing else is read, and no file is written.
* The password arrives on stdin. It is never an argument (argv is world-readable
  in /proc), never written to a file, never logged, and it is wiped from memory
  as soon as PAM is done with it.
* The check is a local PAM conversation: no network, no helper daemon, no
  session change. It cannot lock or unlock anything by itself; it only answers
  "is this the account's password".

The lock screen uses this to unlock; the lock itself is the shell's own
surface, so a failure here can never lock a session.
"""
import ctypes
import ctypes.util
import getpass
import os
import sys

PAM_PROMPT_ECHO_OFF = 3
PAM_PROMPT_ECHO_ON = 2
PAM_ERROR_MSG = 4
PAM_TEXT_INFO = 5
PAM_CONV_ERR = 19
PAM_SUCCESS = 0
PAM_AUTH_ERR = 7
PAM_USER_UNKNOWN = 10
PAM_MAXTRIES = 8
PAM_AUTHTOK = 6

DEFAULT_SERVICE = "login"


class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_char_p), ("resp_retcode", ctypes.c_int)]


CONV = ctypes.CFUNCTYPE(
    ctypes.c_int,
    ctypes.c_int,
    ctypes.POINTER(ctypes.POINTER(PamMessage)),
    ctypes.POINTER(ctypes.POINTER(PamResponse)),
    ctypes.c_void_p,
)


def pam_strerror(libpam, pamh, code):
    """The message PAM itself gives for a code (never the password)."""
    try:
        libpam.pam_strerror.restype = ctypes.c_char_p
        libpam.pam_strerror.argtypes = [ctypes.c_void_p, ctypes.c_int]
        msg = libpam.pam_strerror(pamh, code)
        return msg.decode("utf-8", "replace") if msg else "unknown PAM error"
    except Exception:
        return "unknown PAM error"


def main(argv):
    user = getpass.getuser()
    service = os.environ.get("MEI_LOCK_PAM_SERVICE", DEFAULT_SERVICE)
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--user" and args:
            user = args.pop(0)
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            print("mei-lock-verify: unknown argument %r" % a, file=sys.stderr)
            return 2

    libpam_path = ctypes.util.find_library("pam")
    if not libpam_path:
        print("mei-lock-verify: libpam is not installed", file=sys.stderr)
        return 2
    libpam = ctypes.CDLL(libpam_path, use_errno=True)

    password = sys.stdin.readline()
    if password.endswith("\n"):
        password = password[:-1]
    if password == "":
        # An empty password is never accepted silently: a PAM service with
        # nullok would, and that is a policy decision, not ours.
        print("mei-lock-verify: no password given", file=sys.stderr)
        return 1

    # The conversation: hand PAM the password once, for the echo-off prompt.
    #
    # libpam frees the response array and the response strings itself, so both
    # have to come from C's allocator. A Python bytes object handed to PAM
    # would be freed by the wrong allocator, which is a crash, not a wrong
    # answer.
    libc = ctypes.CDLL("libc.so.6")
    libc.malloc.restype = ctypes.c_void_p
    libc.malloc.argtypes = [ctypes.c_size_t]

    def c_string(data):
        buf = libc.malloc(len(data) + 1)
        ctypes.memmove(buf, data, len(data) + 1)
        return ctypes.cast(buf, ctypes.c_char_p)

    def converse(num_msg, msgp, respp, appdata):
        count = max(1, num_msg)
        size = ctypes.sizeof(PamResponse)
        arr = libc.malloc(size * count)
        responses = (PamResponse * count).from_address(arr)
        for i in range(count):
            try:
                style = msgp[i].contents.msg_style if num_msg > 0 else PAM_PROMPT_ECHO_OFF
            except Exception:
                style = PAM_PROMPT_ECHO_OFF
            payload = password.encode("utf-8") if style == PAM_PROMPT_ECHO_OFF else b""
            responses[i].resp = c_string(payload)
            responses[i].resp_retcode = 0
        respp[0] = ctypes.cast(arr, ctypes.POINTER(PamResponse))
        return PAM_SUCCESS

    cb = CONV(converse)

    # pam_start takes a pointer to the handle it fills in.
    pamh = ctypes.c_void_p()
    libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(CONV),
                                  ctypes.POINTER(ctypes.c_void_p)]
    libpam.pam_start.restype = ctypes.c_int
    rc = libpam.pam_start(
        service.encode("utf-8"),
        user.encode("utf-8"),
        ctypes.byref(cb),
        ctypes.byref(pamh),
    )
    if rc != PAM_SUCCESS:
        print("mei-lock-verify: pam_start failed: %s" % pam_strerror(libpam, pamh, rc), file=sys.stderr)
        return 2
    try:
        libpam.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]
        libpam.pam_authenticate.restype = ctypes.c_int
        rc = libpam.pam_authenticate(pamh, 0)
        if rc != PAM_SUCCESS:
            print("mei-lock-verify: %s" % pam_strerror(libpam, pamh, rc), file=sys.stderr)
            return 1
        # The account must be valid too, so a locked-out account cannot unlock.
        libpam.pam_acct_mgmt.argtypes = [ctypes.c_void_p, ctypes.c_int]
        libpam.pam_acct_mgmt.restype = ctypes.c_int
        rc = libpam.pam_acct_mgmt(pamh, 0)
        if rc != PAM_SUCCESS:
            print("mei-lock-verify: %s" % pam_strerror(libpam, pamh, rc), file=sys.stderr)
            return 1
        return 0
    finally:
        try:
            libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
            libpam.pam_end.restype = ctypes.c_int
            libpam.pam_end(pamh, 0)
        except Exception:
            pass
        # Wipe the password we held.
        try:
            password = "\0" * len(password)
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
