#!/usr/bin/env bash
# mei-screenshot: a local screenshot into the user's Pictures folder.
#
#	mei-screenshot [region|full] [--no-clipboard] [--no-notify]
#
# Deliberately local: grim or slurp write a PNG, wl-copy puts it on the
# clipboard and notify-send announces it. There is no upload, no share
# service, no helper daemon and no network call of any kind, so a screenshot
# can never leave the machine.
#
# The file lands in the caller's own Pictures folder: in a test session that
# is Mei's fake home, in a live run it is the owner's real one.
set -euo pipefail

mode="region"
clip=1
notify=1
for arg in "$@"; do
	case "$arg" in
	region | full) mode="$arg" ;;
	--no-clipboard) clip=0 ;;
	--no-notify) notify=0 ;;
	-h | --help)
		printf 'usage: mei-screenshot [region|full] [--no-clipboard] [--no-notify]\n'
		exit 0
		;;
	*) printf 'mei-screenshot: unknown argument "%s"\n' "$arg" >&2; exit 2 ;;
	esac
done

pics="${XDG_PICTURES_DIR:-$HOME/Pictures}"
mkdir -p "$pics"
out="$pics/screenshot-$(date +%Y%m%d-%H%M%S).png"

case "$mode" in
full)
	# grim needs the output it is on; -l 0 keeps the pointer out of the frame.
	grim -l 0 "$out" 2>/dev/null || {
		printf 'mei-screenshot: grim failed\n' >&2
		exit 1
	}
	;;
region)
	# slurp asks the owner to drag the region; it exits non-zero when cancelled.
	if command -v slurp >/dev/null 2>&1; then
		slurp -o "$out" 2>/dev/null || {
			printf 'mei-screenshot: cancelled\n' >&2
			exit 1
		}
	else
		printf 'mei-screenshot: slurp is not installed, taking the full screen\n' >&2
		grim -l 0 "$out" 2>/dev/null || exit 1
	fi
	;;
esac

[ -s "$out" ] || {
	printf 'mei-screenshot: nothing was captured\n' >&2
	exit 1
}

if [ "$clip" = 1 ] && command -v wl-copy >/dev/null 2>&1; then
	wl-copy --type image/png < "$out" 2>/dev/null || true
fi

if [ "$notify" = 1 ] && command -v notify-send >/dev/null 2>&1; then
	notify-send -a "Mei" "Screenshot" "$(basename "$out")" 2>/dev/null || true
fi

printf '%s\n' "$out"
