#!/usr/bin/env bash
# Desktop-relative workspace navigation, and the single source of truth for the
# "desktop" concept the Tenkai overview shows.
#
# A desktop is a block of PER workspace ids: desktop d owns ids
# [d*PER+1 .. d*PER+PER]. The current desktop is DERIVED from the focused
# monitor's active workspace, so Super+N always targets the Nth workspace of the
# desktop you are on (on desktop 2, Super+3 -> ws13, never ws3) and a window sent
# with Super+Alt+N stays on the current desktop instead of jumping to desktop 1.
#
# PER must match the overview's `perDesktop`
# (ryoku/shell/quickshell/overview/Overview.qml). It is the one design constant;
# the live desktop is computed, never stored, so it can never drift.
#
#   tenkai-workspace desktop          print the current desktop index (0-based)
#   tenkai-workspace focus <1..PER>   focus the Nth workspace of the current desktop
#   tenkai-workspace move  <1..PER>   move the active window there (and follow it)
#   tenkai-workspace hide             stash the focused window in the scratchpad,
#                                    or pull it back out if it is already there
#   tenkai-workspace scratch          show the scratchpad, or hide it and hand
#                                    keyboard focus back to what is on screen
#
# The desktop grid and the scratchpad are fixed-workspace-model, special-workspace
# behaviours. A compositor that drives its own workspaces has neither, so each
# command stands down there instead of dispatching at a socket that will not answer.
#
set -euo pipefail

PER=10

tenkai_bin="${TENKAI_BIN:-${RYOKU_BIN:-$(command -v tenkai || true)}}"

# The seam is optional. When a tenkai binary that implements `wm status` is on
# PATH it names the capabilities and model. Otherwise this script is shipping
# inside Tenkai's Hyprland config, so ask Hyprland directly: the grid is fixed
# and the scratchpad exists. Without this fallback the helper stood down with
# "manages its own workspaces" and every Super+N.workspace bind did nothing.
seam_status() {
  [[ -n $tenkai_bin && -x $tenkai_bin ]] || return 1
  "$tenkai_bin" wm status 2>/dev/null
}

wm_can() {  # capability -> 0 when the live compositor honours it
  local st
  if st=$(seam_status) && [[ -n $st ]]; then
    case ",$(printf '%s\n' "$st" | sed -n 's/^Capabilities: //p' | tr -d '[:space:]')," in
      *",$1,"*) return 0 ;;
    esac
    return 1
  fi
  # No seam: Hyprland, which owns a scratchpad workspace.
  [[ $1 == specialWorkspace ]]
}

wm_model() {  # the live compositor's workspace model (fixed | dynamic | empty)
  local st m
  if st=$(seam_status) && [[ -n $st ]]; then
    m=$(printf '%s\n' "$st" | sed -n 's/^Workspace model: //p' | tr -d '[:space:]')
    [[ -n $m ]] && { echo "$m"; return; }
  fi
  if hyprctl version >/dev/null 2>&1; then echo fixed; else echo empty; fi
}

# Hyprland's Lua config parses `hyprctl dispatch` arguments as Lua, so the
# classic `dispatch workspace 2` is rejected there; a classic config rejects
# the hl.dsp form. Try the form this session needs first, fall back to the
# other, and never report success when the compositor returned an error.
dispatch_lua() {  # $1 = lua expression, $2 = classic fallback words...
  local expr=$1 out; shift
  out=$(hyprctl dispatch "$expr" 2>&1 || true)
  case "$out" in
    *error*|*Error*|*invalid*|*Invalid*) hyprctl dispatch "$@" >/dev/null 2>&1 || true ;;
  esac
}

focus_ws() { dispatch_lua "hl.dsp.focus({ workspace = $1 })" workspace "$1"; }
move_ws()  { dispatch_lua "hl.dsp.window.move({ workspace = $1 })" movetoworkspace "$1"; }

# The grid is numbered slots a user thinks of by position, which needs a fixed
# workspace model; a dynamic-workspace compositor grows and shrinks its set, so
# the grid stands down rather than acting on ids that do not line up.
require_grid() {
  if [[ "$(wm_model)" == fixed ]]; then
    return 0
  fi
  echo "tenkai-workspace: this window manager manages its own workspaces; the desktop grid is fixed-model only" >&2
  exit 0
}

# hide/scratch stash a window on a special (scratchpad) workspace; a compositor
# without one has nowhere to put it.
require_scratchpad() {
  if wm_can specialWorkspace; then
    return 0
  fi
  echo "tenkai-workspace: this window manager has no scratchpad" >&2
  exit 0
}

active_ws() { hyprctl activeworkspace -j | jq -r '.id' 2>/dev/null || echo 0; }

# The special workspace open on the focused monitor, or empty when none is.
special_ws() { hyprctl monitors -j | jq -r '.[]|select(.focused)|.specialWorkspace.name' 2>/dev/null || echo ""; }

# Must match the special workspace binds.lua toggles on Super+Alt+H.
SCRATCH=scratch

current_desktop() {
  local a
  a=$(active_ws)
  # special (negative) or unresolved -> desktop 0.
  if [[ -z $a || $a -lt 1 ]]; then
    echo 0
  else
    echo $(( (a - 1) / PER ))
  fi
}

# slot (1..PER) -> absolute workspace id on the current desktop.
target_ws() {
  local slot=$1 desk
  desk=$(current_desktop)
  echo $(( desk * PER + slot ))
}

cmd=${1:-}
case "$cmd" in
  desktop)
    if [[ "$(wm_model)" == fixed ]]; then current_desktop; else echo 0; fi
    ;;
  focus)
    require_grid
    ws=$(target_ws "${2:?slot 1..$PER required}")
    # focusing a workspace already moves focus to the monitor that owns it, so
    # a workspace on a secondary monitor stays put.
    focus_ws "$ws"
    ;;
  move)
    require_grid
    ws=$(target_ws "${2:?slot 1..$PER required}")
    move_ws "$ws"
    ;;
  movesilent)
    require_grid
    ws=$(target_ws "${2:?slot 1..$PER required}")
    addr=$(hyprctl activewindow -j | jq -r '.address')
    dispatch_lua "hl.dsp.window.move({
        workspace = \"$ws\",
        window = \"address:$addr\",
        follow = false
    })" movetoworkspacesilent "$ws,address:$addr"
    ;;
  hide)
    require_scratchpad
    ws=$(hyprctl activewindow -j 2>/dev/null | jq -r '.workspace.name // empty' || true)
    [[ -z $ws ]] && exit 0
    back=$(active_ws)
    [[ $back -lt 1 ]] && exit 0
    if [[ $ws == special:* ]]; then
      # activeworkspace reports the normal workspace under an open overlay, which
      # is where the window came from. Not silent: following it restores focus.
      move_ws "$back"
    else
      # No float/resize/centre: rewriting geometry would return a tiled window as
      # a centred float instead of to its slot.
      dispatch_lua "hl.dsp.window.move({ workspace = \"special:$SCRATCH\", silent = true })" movetoworkspacesilent "special:$SCRATCH"
      # A silent move still drags focus into the scratchpad, which shows it. Undo
      # both, or the window stays on screen and typing goes somewhere invisible.
      [[ $(special_ws) == "special:$SCRATCH" ]] &&
        dispatch_lua "hl.dsp.workspace.toggle_special(\"$SCRATCH\")" togglespecialworkspace "$SCRATCH"
      focus_ws "$back"
    fi
    ;;
  scratch)
    require_scratchpad
    # activeworkspace reports the normal workspace under an open overlay, so this
    # is what is on screen either way.
    back=$(active_ws)
    dispatch_lua "hl.dsp.workspace.toggle_special(\"$SCRATCH\")" togglespecialworkspace "$SCRATCH"
    # Hyprland leaves keyboard focus on the window it just hid. The next surface
    # that takes and releases a keyboard grab (any bar panel or menu) then hands
    # focus back to it, and focusing a window on a special workspace shows that
    # workspace: closing a panel would pop the scratchpad straight back open.
    #
    # So hiding hands focus to a window that is actually on screen. It has to be a
    # window, not the workspace: focusing an empty workspace leaves Hyprland with
    # nothing to focus, so it keeps the hidden window and re-reveals the
    # scratchpad on the spot. Nothing to hand focus to means leave it alone.
    if [[ -z $(special_ws) && $back -ge 1 ]]; then
      addr=$(hyprctl clients -j 2>/dev/null | jq -r --argjson ws "$back" \
        'map(select(.workspace.id == $ws)) | sort_by(.focusHistoryID) | .[0].address // empty' \
        || true)
      [[ -n $addr ]] &&
        dispatch_lua "hl.dsp.focus({ window = \"address:$addr\" })" focuswindow "address:$addr"
    fi
    ;;
  *)
    echo "usage: tenkai-workspace {desktop|focus <1..$PER>|move <1..$PER>|hide|scratch}" >&2
    exit 2
    ;;
esac
